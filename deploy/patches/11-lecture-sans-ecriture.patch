+    doc && typeof doc === "object" && !Array.isArray(doc)
+      ? (() => {
+          const { timestamp: _ignoré, ...reste } = doc as Record<string, unknown>;
+          return reste;
+        })()
+      : doc;
+  return JSON.stringify(normaliser(sansHorodatage));
+}
