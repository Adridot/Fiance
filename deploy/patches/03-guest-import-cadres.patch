+// ─── mapRowsToGuests — invitation types ──────────────────────────────────────
+
+describe("mapRowsToGuests — invitation types", () => {
+  const sheetWith = (header: string, values: string[]) => ({
+    headers: ["Prénom", "Nom", header],
+    rows: values.map((v, i) => [`Prenom${i}`, `Nom${i}`, v]),
+  });
