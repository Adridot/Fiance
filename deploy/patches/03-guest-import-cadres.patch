+
+  it("an empty column marks nothing", () => {
+    let n = 0;
+    const r = mapRowsToGuests(sheet([""]), { groups: [], tables: [] }, { makeId: () => `i-${n++}` });
+    expect(r.guests[0].isChild).toBe(false);
+    expect(r.guests[0].childrenCount).toBe(0);
