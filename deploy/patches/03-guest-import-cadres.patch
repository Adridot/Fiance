+
+describe("reconcileGuests", () => {
+  it("does not add a guest already present: the import is replayable", () => {
+    const existing = [guest({ firstName: "Jean", lastName: "Dupont" })];
+    const incoming = [guest({ id: "new", firstName: "Jean", lastName: "Dupont" })];
